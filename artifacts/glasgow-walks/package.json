{
  "name": "@workspace/glasgow-walks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:export": "node scripts/export-supabase-setup.mjs",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "node scripts/export-supabase-setup.mjs && vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:planner": "node scripts/test-planner.mjs",
    "test:starting-areas": "node scripts/test-starting-areas.mjs",
    "test:starting-areas:browser": "tsc -p tsconfig.walk-browser.json --noEmit && playwright test --config playwright.starting-areas.config.mjs",
    "test:walks": "node scripts/test-curated-walks.mjs",
    "test:walks:browser": "tsc -p tsconfig.walk-browser.json --noEmit && { playwright test --config playwright.walks.config.mjs; walk_status=$?; playwright test --config playwright.walk-list.config.mjs; list_status=$?; [ $walk_status -eq 0 ] && [ $list_status -eq 0 ]; }",
    "test:walks:list:browser": "tsc -p tsconfig.walk-browser.json --noEmit && playwright test --config playwright.walk-list.config.mjs",
    "test:admin": "node scripts/export-supabase-setup.mjs && node scripts/test-admin-security.mjs",
    "test:admin:browser": "tsc -p tsconfig.walk-browser.json --noEmit && playwright test --config playwright.walks.config.mjs --grep \"admin auth\""
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^25.3.3",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "leaflet": "^1.9.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  }
}